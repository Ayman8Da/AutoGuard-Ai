# ---- AutoGuard AI configuration (copy to .env) ----
# Never commit a real .env file.

AUTOGUARD_ENVIRONMENT=local
AUTOGUARD_DEBUG=false

# Logging: json (production) or console (local readability)
AUTOGUARD_LOG_LEVEL=INFO
AUTOGUARD_LOG_FORMAT=json

# Comma-separated list; leave empty to disable CORS
AUTOGUARD_CORS_ORIGINS=

# In-memory buffers (records kept per process)
AUTOGUARD_TELEMETRY_BUFFER_SIZE=1000
AUTOGUARD_DIAGNOSTICS_BUFFER_SIZE=500
AUTOGUARD_INCIDENT_BUFFER_SIZE=500
AUTOGUARD_MONITORING_BUFFER_SIZE=5000

# LLM inference: mock | groq | ollama
# "mock" keeps the whole stack runnable and testable without any API key.
AUTOGUARD_LLM_PROVIDER=mock
AUTOGUARD_LLM_MODEL=llama-3.3-70b-versatile
AUTOGUARD_LLM_TIMEOUT_SECONDS=30
AUTOGUARD_AGENT_MAX_RETRIES=1

# Required only when AUTOGUARD_LLM_PROVIDER=groq
AUTOGUARD_GROQ_API_KEY=

# Used only when AUTOGUARD_LLM_PROVIDER=ollama
AUTOGUARD_OLLAMA_BASE_URL=http://localhost:11434
